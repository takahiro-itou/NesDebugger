<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>NesDebugView</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>WinExe</OutputType>
    <Platforms>x64;x86</Platforms>
    <RootNamespace>NesDebugView</RootNamespace>
    <TargetFrameworks>
      net48
    </TargetFrameworks>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <Import Project="..\Props\OutputApps.props" />

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net48' ">
    <ProjectReference Include="..\Cli.NetFramework4.8\Wrapper.Net48.vcxproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WpfControl\WpfControl.NetOld.csproj" />
    <ProjectReference Include="..\NesWpfControl\NesWpfControl.NetOld.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Application.xaml.vb" />
    <Compile Include="Views/MainWindow.xaml.vb" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="mscorlib" />
  </ItemGroup>

</Project>
